---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBrand } from '../data/site';
import { getTopic, type Topic } from '../data/topics';
import { TOPIC_GROUP_LABELS } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const groupLabel = TOPIC_GROUP_LABELS[topic.group];

const title = withBrand(topic.h1);
const description = topic.metaDescription;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const homeUrl = Astro.site ? new URL('/', Astro.site).href : '/';
const clusterUrl = Astro.site ? new URL('/#guides', Astro.site).href : '/#guides';

// JSON-LD: WebPage(about attraction) + BreadcrumbList + FAQPage
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: topic.h1,
  description: topic.metaDescription,
  inLanguage: 'ko-KR',
  url: canonical,
  about: { '@type': 'TouristAttraction', name: '명동 야시장', url: homeUrl },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: groupLabel, item: clusterUrl },
    { '@type': 'ListItem', position: 3, name: topic.h1, item: canonical },
  ],
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
  </Fragment>

  <section class="prose-page">
    <div class="page-shell shell">
      <p class="eyebrow">{topic.kicker}</p>
      <h1>{topic.h1}</h1>
      <p class="lead">{topic.lead}</p>
      <p class="topic-updated">최종 자료 확인 · {topic.updated}</p>

      {topic.sections.map((s) => (
        <section class="topic-section">
          <h2>{s.heading}</h2>
          {s.paragraphs?.map((p) => <p>{p}</p>)}
          {s.bullets && (
            <ul>
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.callout && <p class="note">{s.callout}</p>}
        </section>
      ))}

      <section class="topic-section" id="faq">
        <h2>자주 묻는 질문</h2>
        <div class="guide-faq">
          {topic.faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      {topic.related.length > 0 && (
        <section class="topic-section" id="related">
          <h2>함께 보기</h2>
          <div class="related-grid">
            {topic.related.map((slug) => {
              const rel = getTopic(slug);
              if (!rel) return null;
              return (
                <a class="related-card" href={`/${slug}/`}>
                  <span class="related-kicker">{rel.kicker}</span>
                  <span class="related-title">{rel.h1}</span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <section class="topic-section">
        <p class="note">
          본 페이지는 독립 비영리 방문자 정보 안내이며, 명동 야시장 운영 주체 또는 공식 기관과 무관합니다.
          운영 시간·가격·교통 등 변동 정보는 표기된 날짜 기준이며 방문 전 현장 또는 공식 안내로 재확인하세요.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-page .eyebrow { margin-bottom: .6rem; }
  .prose-page h1 { margin-bottom: .8rem; }
  .topic-updated { color: var(--cyan); font-weight: 800; font-size: .82rem; margin: 0 0 2.2rem; }
  .topic-section { margin-top: 2.6rem; }
  .topic-section h2 { font-size: 1.6rem; letter-spacing: -.02em; margin-bottom: .8rem; }
  .topic-section p, .topic-section li { color: #cbc6d7; line-height: 1.9; }
  .topic-section ul { padding-left: 1.2rem; display: grid; gap: .4rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; }
  .related-card { display: flex; flex-direction: column; gap: .4rem; padding: 1.1rem 1.25rem; border: 1px solid var(--line); border-radius: 1.1rem; text-decoration: none; background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.025)); transition: border-color .2s; }
  .related-card:hover { border-color: rgba(70,230,225,.4); }
  .related-kicker { color: var(--cyan); font-size: .72rem; font-weight: 900; letter-spacing: .08em; }
  .related-title { color: #f8f4ff; font-weight: 850; font-size: 1rem; line-height: 1.4; }
  @media (max-width: 860px) { .related-grid { grid-template-columns: 1fr; } }
</style>
